<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Fg}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Fg}" />
        <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Fg}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Fg3}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource Fg}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Fg3}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Fg2}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Bg}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Fg}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Fg}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Fg3}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Fg3}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="#F20F0F0F" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Fg}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Fg}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Fg3}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Bg}" />
        <Setter Property="BarTextColor" Value="{StaticResource Fg}" />
    </Style>
</ResourceDictionary>
